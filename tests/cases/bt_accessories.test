# fake_moonraker
# AFC's accessories on COSMOS's BoxTurtle (configs/boxturtle_m2.cfg): lane1's
# button (a short press loads the tool, TEST_BUTTON as the AFC-Lite reports
# it), the tip forming settings and test, then a tool unload that forms the
# tip (form_tip_cmd: AFC) before the lane retracts
CONFIG ../configs/boxturtle_m2.cfg
DICTIONARY atmega2560.dict Turtle_1=stm32h723.dict

G4 P1000
SET_KINEMATIC_POSITION X=100 Y=100 Z=10
WAIT 6
TEST_BUTTON PIN=^!Turtle_1:TRG1 STATE=1
WAIT 6
TEST_BUTTON PIN=^Turtle_1:SW6 STATE=1
WAIT 0.5
TEST_BUTTON PIN=^Turtle_1:SW6 STATE=0
WAIT 3
GET_TIP_FORMING
SET_TIP_FORMING RAMMING_VOLUME=23 COOLING_MOVES=2 USE_SKINNYDIP=TRUE MELT_ZONE_PAUSE=0.5 COOLING_ZONE_PAUSE=0.5
GET_TIP_FORMING
TEST_AFC_TIP_FORMING
SET_TIP_FORMING USE_SKINNYDIP=false RAMMING_VOLUME=0
T0
WAIT 2
TEST_BUTTON PIN=^PK1 STATE=0
WAIT 2
TOOL_UNLOAD LANE=lane1
WAIT 3
AFC_STATUS
