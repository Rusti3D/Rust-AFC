# fake_moonraker
# COSMOS BoxTurtle without LEDs, buffer, espoolers (configs/boxturtle_min.cfg): PREP, status, lane moves on the
# lane steppers (forward and back), lane settings, and a load AFC refuses (batch
# mode: no sensor ever triggers, so every lane reads empty)
CONFIG ../configs/boxturtle_min.cfg
DICTIONARY atmega2560.dict Turtle_1=stm32h723.dict

G4 P1000
PREP
AFC_STATUS
LANE_MOVE LANE=lane1 DISTANCE=50
LANE_MOVE LANE=lane2 DISTANCE=-20
LANE_MOVE LANE=lane4 DISTANCE=250
SET_COLOR LANE=lane1 COLOR=FF0000
SET_MATERIAL LANE=lane1 MATERIAL=PETG
SET_MAP LANE=lane1 MAP=T3
SET_WEIGHT LANE=lane2 WEIGHT=850
TOOL_LOAD LANE=lane1
AFC_STATS
