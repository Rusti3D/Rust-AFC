# fake_ace: --slots ready:PLA,empty,ready:PETG,empty --speedup 10 --events 20:0:empty,28:0:ready:PLA
# fake_moonraker
# A spool runs out mid-print with no runout lane (COSMOS's afc.cfg:
# unload_on_runout): AFC pauses and unloads the spent spool; its eject has
# nothing to retract. A new spool in that lane is loaded and purged by itself
# (AFC_ACE _reload), then RESUME is accepted and the print cancelled
# (SDCARD_RESET_FILE: a paused print's file stops before its next line, the
# same on both sides). RUN_SHELL_COMMAND (sleep) holds the test while the
# events happen; the comment block ends the first 4 KiB batch of input, which
# frees the g-code lock for the reload's TOOL_LOAD.
CONFIG ../configs/ace_runout.cfg
DICTIONARY atmega2560.dict

G4 P1000
G28
PREP
TOOL_LOAD LANE=lane1
SDCARD_PRINT_FILE FILENAME=ace_runout.gcode
RUN_SHELL_COMMAND CMD=hold PARAMS=35
