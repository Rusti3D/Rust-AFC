# fake_ace: --slots ready:PLA,empty,ready:PETG,empty --speedup 10 --events 20:0:empty,28:0:ready:PLA
# fake_moonraker
# ace_runout.test with unload_on_runout off: the pause keeps the spent spool
# booked in, and the reload books it out (as a spent-spool unload) first.
CONFIG ../configs/ace_runout_keep.cfg
DICTIONARY atmega2560.dict

G4 P1000
G28
PREP
TOOL_LOAD LANE=lane1
SDCARD_PRINT_FILE FILENAME=ace_runout_keep.gcode
RUN_SHELL_COMMAND CMD=hold PARAMS=35
