# fake_moonraker
# An HTLF (configs/htlf_flow.cfg: sensors following the homing moves; the
# cam's home switch follows its homing too): a spool into lane1 (its load
# switch is its prep), a tool load through the hub, the unload and an eject
CONFIG ../configs/htlf_flow.cfg
DICTIONARY atmega2560.dict Turtle_1=stm32h723.dict

G4 P1000
SET_KINEMATIC_POSITION X=100 Y=100 Z=10
WAIT 6
TEST_BUTTON PIN=^Turtle_1:EXT1 STATE=1
WAIT 6
T0
WAIT 3
TEST_BUTTON PIN=^PK1 STATE=0
WAIT 2
TOOL_UNLOAD LANE=lane1
WAIT 3
LANE_UNLOAD LANE=lane1
WAIT 3
AFC_STATUS
